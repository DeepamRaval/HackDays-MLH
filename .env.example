# ─── Snowflake (data layer + Cortex AI) ─────────────────────────────────────
# All AI features (chat, analysis explanation, history NL→SQL) run on
# Snowflake Cortex with llama3.1-70b — available in India.
SNOWFLAKE_ACCOUNT=xy12345.ap-south-1.aws    # no .snowflakecomputing.com suffix
SNOWFLAKE_USER=MY_USER
SNOWFLAKE_PASSWORD=MY_SECURE_PASSWORD
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=TRADING_DB
SNOWFLAKE_SCHEMA=PUBLIC

# ─── Flask ────────────────────────────────────────────────────────────────────
FLASK_SECRET_KEY=change_this_to_a_random_string
